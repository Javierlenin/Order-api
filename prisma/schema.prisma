generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  EN_PREPARACION
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum AdjustmentType {
  INGRESO
  SALIDA
}

enum MovementType {
  INGRESO
  SALIDA
  DEVOLUCION
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(250)
  status      Boolean @default(true)

  users User[]

  @@map("roles")
}

model User {
  id           Int      @id @default(autoincrement())
  roleId       Int      @map("role_id")
  name         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  status       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamp(0)

  role                 Role                  @relation(fields: [roleId], references: [id])
  orders               Order[]
  inventoryAdjustments InventoryAdjustment[]
  inventoryMovements   InventoryMovement[]

  @@map("users")
}

model Customer {
  id             Int      @id @default(autoincrement())
  identification String   @unique @db.VarChar(30)
  name           String   @db.VarChar(150)
  email          String?  @db.VarChar(150)
  phone          String?  @db.VarChar(30)
  address        String?  @db.VarChar(300)
  status         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamp(0)

  orders Order[]

  @@map("customers")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(250)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamp(0)

  products Product[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  categoryId  Int      @map("category_id")
  codeProduct String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamp(0)

  category                   Category                    @relation(fields: [categoryId], references: [id])
  orderDetails               OrderDetail[]
  inventoryAdjustmentDetails InventoryAdjustmentDetail[]
  inventoryMovements         InventoryMovement[]

  @@map("products")
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber Int         @unique @default(autoincrement()) @map("order_number")
  customerId  Int         @map("customer_id")
  userId      Int         @map("user_id")
  orderDate   DateTime    @default(now()) @map("order_date") @db.Timestamp(0)
  subtotal    Decimal     @default(0) @db.Decimal(12, 2)
  tax         Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @default(0) @db.Decimal(12, 2)
  status      OrderStatus @default(PENDIENTE)
  notes       String?     @db.VarChar(500)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime    @default(now()) @map("updated_at") @db.Timestamp(0)

  customer           Customer            @relation(fields: [customerId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  details            OrderDetail[]
  inventoryMovements InventoryMovement[]

  @@index([customerId, orderDate(sort: Desc)], map: "IX_orders_customer_date")
  @@index([userId, orderDate(sort: Desc)], map: "IX_orders_user_date")
  @@map("orders")
}

model OrderDetail {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  productId Int      @map("product_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "IX_order_details_order")
  @@map("order_details")
}

model InventoryAdjustment {
  id             Int            @id @default(autoincrement())
  userId         Int            @map("user_id")
  adjustmentType AdjustmentType @map("adjustment_type")
  reason         String?        @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamp(0)

  user      User                        @relation(fields: [userId], references: [id])
  details   InventoryAdjustmentDetail[]
  movements InventoryMovement[]

  @@index([createdAt(sort: Desc)], map: "IX_inventory_adjustments_date")
  @@map("inventory_adjustments")
}

model InventoryAdjustmentDetail {
  id           Int @id @default(autoincrement())
  adjustmentId Int @map("adjustment_id")
  productId    Int @map("product_id")
  quantity     Int
  stockBefore  Int @map("stock_before")
  stockAfter   Int @map("stock_after")

  adjustment InventoryAdjustment @relation(fields: [adjustmentId], references: [id])
  product    Product             @relation(fields: [productId], references: [id])

  @@map("inventory_adjustment_details")
}

model InventoryMovement {
  id           Int          @id @default(autoincrement())
  productId    Int          @map("product_id")
  orderId      Int?         @map("order_id")
  adjustmentId Int?         @map("adjustment_id")
  userId       Int          @map("user_id")
  movementType MovementType @map("movement_type")
  quantity     Int
  stockBefore  Int          @map("stock_before")
  stockAfter   Int          @map("stock_after")
  description  String?      @db.VarChar(500)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamp(0)

  product    Product              @relation(fields: [productId], references: [id])
  order      Order?               @relation(fields: [orderId], references: [id])
  adjustment InventoryAdjustment? @relation(fields: [adjustmentId], references: [id])
  user       User                 @relation(fields: [userId], references: [id])

  @@index([orderId], map: "IX_inventory_movements_order")
  @@map("inventory_movements")
}
